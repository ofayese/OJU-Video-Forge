FROM quay.io/docling-project/docling-serve-cpu@sha256:8376600bcc1ba41d06b26f4af10fe1ba0071578e85d0857447f4c2fdda9308a8

WORKDIR /opt/ocr
COPY --chown=1001:0 services/docling-ocr/requirements-docling-ocr-gpu.txt ./requirements-docling-ocr-gpu.txt
RUN python -m pip uninstall -y onnxruntime torch torchvision \
 && python -m pip install --no-cache-dir --require-hashes -r requirements-docling-ocr-gpu.txt \
 && python -m pip check \
 && python -c "import importlib.metadata as m; expected={'docling-serve':'1.37.0','docling-slim':'2.142.0','rapidocr':'3.10.0','onnxruntime-gpu':'1.31.0','torch':'2.14.1+cu130','torchvision':'0.29.1+cu130'}; actual={name:m.version(name) for name in expected}; mismatches={name:(actual[name],version) for name,version in expected.items() if actual[name] != version}; assert not mismatches, f'Docling GPU runtime mismatch: {mismatches}'"

COPY --chown=1001:0 services/docling-ocr/run_docling.py services/docling-ocr/start_docling_serve_gpu.py ./
ENV DOCLING_SERVE_ENABLE_UI=false \
    DOCLING_SERVE_ENABLE_API_DOCS=false \
    DOCLING_SERVE_ENABLE_CAPABILITIES_ENDPOINT=false \
    DOCLING_SERVE_SHOW_VERSION_INFO=false \
    DOCLING_SERVE_DEFAULT_OCR_PRESET=rapidocr \
    DOCLING_SERVE_ALLOWED_OCR_PRESETS='["rapidocr"]' \
    DOCLING_SERVE_ALLOW_CUSTOM_OCR_CONFIG=false \
    DOCLING_SERVE_ENABLE_REMOTE_SERVICES=false \
    DOCLING_DEVICE=cuda:0 \
    DOCLING_SERVE_MAX_FILE_SIZE=2097152 \
    DOCLING_SERVE_MAX_DOCUMENT_TIMEOUT=25 \
    DOCLING_SERVE_MAX_SYNC_WAIT=25 \
    DOCLING_SERVE_SYNC_POLL_INTERVAL=1 \
    DOCLING_SERVE_OCR_BATCH_SIZE=1 \
    DOCLING_SERVE_QUEUE_MAX_SIZE=1 \
    DOCLING_SERVE_ENG_LOC_NUM_WORKERS=1 \
    DOCLING_SERVE_OPTIONS_CACHE_SIZE=1 \
    DOCLING_PERF_PAGE_BATCH_SIZE=1 \
    DOCLING_NUM_THREADS=1 \
    DOCLING_SERVE_CORS_ORIGINS='[]' \
    DOCLING_SERVE_CORS_METHODS='[]' \
    DOCLING_SERVE_CORS_HEADERS='[]' \
    DOCLING_SERVE_LOG_FORMAT=json \
    UVICORN_WORKERS=1 \
    UVICORN_PROXY_HEADERS=false \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    DO_NOT_TRACK=1 \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    CUDA_VISIBLE_DEVICES=0 \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
USER 1001:0
CMD ["python", "/opt/ocr/start_docling_serve_gpu.py", "--host", "0.0.0.0", "--port", "9623"]
