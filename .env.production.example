APP_ENV=production
APP_BASE_URL=https://video.olutechsys.com
API_BASE_URL=https://video-api.olutechsys.com

AUTH_PROVIDER=local
AD_ENABLED=false
AZURE_ENABLED=false
EXTERNAL_ACCESS_ENABLED=false

AD_DOMAIN=ojuidc.olutech.systems
PUBLIC_APP_FQDN=video.olutechsys.com
PUBLIC_API_FQDN=video-api.olutechsys.com

DATABASE_URL=postgresql+psycopg://forge:${DB_PASSWORD}@postgres:5432/forge
REDIS_URL=redis://redis:6379/0
COMFYUI_URL=http://comfyui:8188
COMFYUI_ENABLED=false
ARTIFACT_ROOT=/artifacts
FORGE_DATA=REPLACE_WITH_PRIVATE_DATA_PATH
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
FORGE_OPENWEBUI_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
FORGE_CHATGPT_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
WAN_NODE_MAPPING={}

# Production must never silently fall back to local development defaults.
# Configure a verified reverse proxy, TLS, and auth provider before enabling public access.
