APP_ENV=production
APP_BASE_URL=https://video.olutechsys.com
API_BASE_URL=https://video-api.olutechsys.com

AUTH_PROVIDER=local
AD_ENABLED=false
AZURE_ENABLED=false
EXTERNAL_ACCESS_ENABLED=false
AGENTS_ENABLED=false
AGENT_PROVIDER=
AGENT_URL=
AGENT_MODEL=
AGENT_MODEL_DIGEST=
AGENT_STAGE_TIMEOUT_SECONDS=60
AGENT_GENERATION_TIMEOUT_SECONDS=300

AD_DOMAIN=ojuidc.olutech.systems
PUBLIC_APP_FQDN=video.olutechsys.com
PUBLIC_API_FQDN=video-api.olutechsys.com

DATABASE_URL=postgresql+psycopg://forge:${DB_PASSWORD}@postgres:5432/forge
REDIS_URL=redis://redis:6379/0
COMFYUI_URL=http://comfyui:8188
COMFYUI_ENABLED=false
NARRATION_VISION_URL=
NARRATION_VISION_MODEL=
NARRATION_VISION_MODEL_DIGEST=

TRAINING_TEXT_PROVIDER=ollama
TRAINING_TEXT_URL=http://ollama:11434
TRAINING_TEXT_MODEL=
TRAINING_TEXT_MODEL_DIGEST=
TRAINING_TEXT_STAGE_TIMEOUT_SECONDS=60
TRAINING_TEXT_GENERATION_TIMEOUT_SECONDS=300
ARTIFACT_ROOT=/artifacts
REVIEW_WORKFLOW_ENABLED=true
FORGE_DATA=REPLACE_WITH_PRIVATE_DATA_PATH
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
FORGE_OPENWEBUI_TOKEN=
FORGE_CHATGPT_TOKEN=
WAN_NODE_MAPPING={}

# Trusted host telemetry for heavy-inference admission (supplied via secret at deploy time).
INFERENCE_TELEMETRY_FILE=
INFERENCE_TELEMETRY_HMAC_KEY=
INFERENCE_TELEMETRY_STATE_FILE=
INFERENCE_TELEMETRY_ALLOWED_SOURCE_IDS=
INFERENCE_TELEMETRY_MAX_AGE_SECONDS=
INFERENCE_TELEMETRY_CLOCK_SKEW_SECONDS=

# Production must never silently fall back to local development defaults.
# Configure a verified reverse proxy, TLS, and auth provider before enabling public access.
